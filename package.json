{
  "name": "estudio-juridico-rs",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "description": "Sitio institucional de Estudio Jurídico RS",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "predev": "npm run images:optimize",
    "dev": "vite",
    "start": "npm run dev",
    "prebuild": "npm run images:optimize",
    "build": "vite build",
    "postbuild": "node scripts/prerender-routes.mjs && node scripts/verify-build.mjs",
    "preview": "vite preview",
    "images:optimize": "node scripts/optimize-images.mjs && node scripts/generate-icons.mjs",
    "test": "node --test",
    "check": "npm run lint && npm run test && npm run build",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fontsource/quattrocento": "^5.3.0",
    "bootstrap": "^5.3.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "sass": "^1.108.2",
    "sharp": "^0.35.5",
    "vite": "^8.1.0"
  }
}
