    "test": "node --test",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "bootstrap": "^5.3.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.26.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.0",
    "sharp": "^0.34.2",
    "vite": "^8.1.0"
  }
}
